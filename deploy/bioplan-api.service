[Unit]
Description=BioPlan API
After=network.target

[Service]
Type=simple
User=root
# Replace /path/to/AI-gantt with the absolute path to your clone
WorkingDirectory=/path/to/AI-gantt
Environment=PYTHONPATH=/path/to/AI-gantt
EnvironmentFile=/path/to/AI-gantt/.env
ExecStart=/path/to/AI-gantt/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
