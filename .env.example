SECRET_KEY=change-me-to-a-long-random-string

# Необязательно. По умолчанию: <репозиторий>/data/bioplan.db
# DATABASE_URL=sqlite:////absolute/path/to/bioplan.db

# Для локального запуска на :8100
CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100,http://localhost:5173

# false для HTTP на ПК; true только за HTTPS на сервере
COOKIE_SECURE=false
DEMO_PM_PASSWORD=pm12345

# deepseek | timeweb | openai — для задач ассистента достаточно DeepSeek V4 Flash
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

TIMEWEB_API_KEY=
TIMEWEB_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/YOUR_AGENT_ID/v1
TIMEWEB_MODEL=deepseek/deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_HOST=127.0.0.1
API_PORT=8100
